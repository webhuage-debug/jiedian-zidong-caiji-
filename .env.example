NODE_ENV=production
APP_NAME=Public Node Admin
APP_HOST=0.0.0.0
APP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Initial admin user. Used only when the database has no admin user yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-before-deploy

# Session and auth safety
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_SECURE=auto
SESSION_TTL_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# SQLite and runtime storage inside Docker volume
DATA_DIR=/data
DATABASE_PATH=/data/app.db
EXPORT_DIR=/data/exports
LOG_LEVEL=info

# Future collection safety defaults
COLLECT_MAX_CONCURRENCY=2
COLLECT_MIN_INTERVAL_MINUTES=60
COLLECT_DAILY_MAX_RUNS=6
HTTP_TIMEOUT_SECONDS=12
COLLECT_RETRY_COUNT=2
COLLECT_MAX_BYTES=1048576

# Optional public seed pages, comma separated. Leave empty to use built-in public discovery queries.
PUBLIC_SOURCE_SEEDS=

# Basic node pre-test. This only opens outbound TCP connections to parsed host:port.
TEST_CONNECT_TIMEOUT_SECONDS=5
TEST_BATCH_SIZE=100
TEST_MAX_CONCURRENCY=20

# Xray-core real proxy test. Disabled by default to protect lightweight VPS.
XRAY_REAL_TEST_ENABLED=false
XRAY_CORE_PATH=/usr/local/bin/xray
XRAY_REAL_TEST_CONCURRENCY=2
XRAY_REAL_TEST_TIMEOUT_SECONDS=12
XRAY_LOCAL_PORT_MIN=32000
XRAY_LOCAL_PORT_MAX=32100
XRAY_TEST_URL=http://www.gstatic.com/generate_204

# Read-only automation API for Hermes / OpenClaw / cron jobs. Leave empty to disable.
AUTOMATION_API_TOKEN=

# Public claim page safety
DOWNLOAD_RATE_LIMIT_PER_MINUTE=6
